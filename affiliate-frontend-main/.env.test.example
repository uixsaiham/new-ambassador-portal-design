# TEST build values for the co-located TEST frontend (test-ambassador.bheuni.uk).
#
# On the TEST box these go in `.env.production.local` (gitignored, and higher
# precedence than the committed .env.production, so the build bakes the TEST api
# url). bootstrap-apps.sh writes that file for you. Prod keeps using .env.production.
#
# Every value here is PUBLIC (NEXT_PUBLIC_* is shipped to the browser).
NEXT_PUBLIC_API_URL=https://test-ambassador-api.bheuni.uk
NEXT_PUBLIC_SITE_URL=https://test-ambassador.bheuni.uk
NEXT_PUBLIC_AMBASSADOR_URL=https://test-ambassador.bheuni.uk
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1048758474269-umhhvonqejjt1mj1le2iskn1ljc9itht.apps.googleusercontent.com
