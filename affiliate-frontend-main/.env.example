# =============================================================================
# Ambassador Portal (frontend) — environment variables
#
# Next.js loads env files with this precedence (highest wins):
#   .env.local  >  .env.production | .env.development  >  .env
#
#   .env.production   (committed)  — defaults for `npm run build` (live URLs)
#   .env.development  (optional)   — defaults for `npm run dev`   (localhost)
#   .env.local        (GITIGNORED) — YOUR personal overrides + any secrets
#   .env.example      (this file)  — documentation; copy to .env.local if needed
#
# IMPORTANT: every NEXT_PUBLIC_* value is bundled into the browser and is
# therefore PUBLIC. Never put a real secret in a NEXT_PUBLIC_ var, and never
# commit real secrets to any env file.
# =============================================================================

# Backend API base URL the frontend calls.
#   local:  http://localhost:8000          production: https://affiliate.bheuni.uk
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public base URL of this portal (used to build shareable referral links).
#   local:  http://localhost:3000          production: https://ambassador.bheuni.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the ambassador portal (landing-page call-to-action).
#   local:  http://localhost:3000          production: https://ambassador.bheuni.uk
NEXT_PUBLIC_AMBASSADOR_URL=http://localhost:3000

# Google OAuth client ID for "Sign in with Google" (a public identifier).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
