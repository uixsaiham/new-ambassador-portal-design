# =============================================================================
# BHE Uni Ambassador Portal - Backend (FastAPI) TEST environment template.
#
# For the co-located TEST backend at test-ambassador-api.bheuni.uk.
# Copy to `.env` on the TEST box ONLY (bootstrap-apps.sh does this for you and
# fills the secrets). Prod uses its own separate .env. `.env` is gitignored;
# this template is committed so the test config is documented and versioned.
#
# The three secrets below are GENERATED per-box by bootstrap-apps.sh.
# NEVER commit real secret values.
# =============================================================================

# Separate SQLite DB, isolated from prod's affiliate.db.
DATABASE_URL=sqlite:///./affiliate_test.db

SECRET_KEY=replace-with-a-generated-test-secret
BANK_ENC_KEY=          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- CRM = L2E DEV -----------------------------------------------------------
CRM_BASE_URL=https://develop-api.theleadlibrary.com
# Must MATCH develop-api's AFFILIATE_SERVICE_KEY (hand this to Anik).
CRM_SERVICE_KEY=

# --- URLs / CORS -------------------------------------------------------------
CORS_ORIGINS=https://test-ambassador.bheuni.uk,http://localhost:3000,http://127.0.0.1:3000
PORTAL_URL=https://test-ambassador.bheuni.uk

# --- Payouts: held to manual in test (never issue real money/gift cards) -----
PAYOUT_PROVIDER=manual
PAYOUT_AUTO_APPROVE_UNDER=0.00

# --- Google OAuth (reuses prod client id; add test origin in Google console) --
GOOGLE_CLIENT_ID=1048758474269-umhhvonqejjt1mj1le2iskn1ljc9itht.apps.googleusercontent.com

# --- Swagger / OpenAPI docs: ON for test so the mobile team can explore the API
# (Swagger at /docs, spec at /openapi.json). Prod leaves this unset (docs off).
ENABLE_DOCS=true

# --- Mail --------------------------------------------------------------------
# Blank in test => sends are no-ops (logged, never crash). Signup OTP is printed
# to the log: `pm2 logs ambassador-api-test` -> "[MAIL] OTP code generated ...".
# Fill MAIL_PASSWORD (O365) or MAILERSEND_API_TOKEN to send real test emails.
MAILERSEND_API_TOKEN=
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@bheuni.io
MAIL_FROM_NAME=BHE Uni Ambassador Portal (TEST)
ADMIN_NOTIFY_EMAILS=shohag@bheuni.io

# --- Reward amounts (mirror prod) --------------------------------------------
LEAD_REWARD_AMOUNT=10.00
ENROLMENT_REWARD_AMOUNT=500.00
