# =============================================================================
# BHE Uni Ambassador Portal — Backend (FastAPI) environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored (it
# holds REAL secrets); this template is committed so anyone knows what to set.
# Values shown are the non-secret code defaults from app/core/config.py —
# every SECRET is intentionally left blank.
#
# NEVER commit real secret values. Secrets live in `.env` only.
# =============================================================================

# --- Core / security ---------------------------------------------------------
# JWT signing key. REQUIRED — generate a long random string:
#   openssl rand -hex 32
SECRET_KEY=

# Database URL. Local dev default is Postgres on localhost; prod uses its own.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/affiliate

# Fernet key that encrypts ambassador bank details at rest. REQUIRED in prod.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP THIS BACKED UP — losing it makes stored bank details unreadable.
BANK_ENC_KEY=

# Browser origins allowed to call this API (comma-separated).
CORS_ORIGINS=https://ambassador.bheuni.uk,http://localhost:3000,http://127.0.0.1:3000

# Google OAuth client ID for "Sign in with Google".
GOOGLE_CLIENT_ID=

# --- CRM integration ---------------------------------------------------------
# Shared secret the CRM sends as X-CRM-Service-Key (must match the CRM side).
CRM_SERVICE_KEY=
# Base URL of the CRM API captured leads are pushed to. Empty disables the push.
CRM_BASE_URL=

# --- MailerLite (marketing sync) ---------------------------------------------
MAILERLITE_API_TOKEN=
MAILERLITE_AMBASSADOR_GROUP_ID=

# --- Reward amounts (BDT) ----------------------------------------------------
LEAD_REWARD_AMOUNT=10.00
ENROLMENT_REWARD_AMOUNT=25000.00

# --- Payout / cash-out policy (BDT) ------------------------------------------
MIN_WITHDRAWAL_AMOUNT=50.00
GIFT_CARD_MIN_WITHDRAWAL_AMOUNT=10.00
MAX_WITHDRAWAL_AMOUNT=5000.00
# 0.00 = disabled -> every withdrawal is PENDING for manual admin settlement.
PAYOUT_AUTO_APPROVE_UNDER=0.00
# Which backend actually moves the money: "manual" | "tremendous" | "tillo" | ...
PAYOUT_PROVIDER=manual
PAYOUT_CURRENCY=BDT

# Bank-transfer fee (gift cards are fee-free).
BANK_WITHDRAWAL_FEE_PERCENT=5
BANK_WITHDRAWAL_FEE_MIN=1.00

# --- Tremendous (gift-card issuance) -----------------------------------------
TREMENDOUS_BASE_URL=https://testflight.tremendous.com/api/v2
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_SOURCE_ID=balance
TREMENDOUS_CAMPAIGN_ID=
TREMENDOUS_PRODUCT_ID=

# --- Love2shop (gift-card issuance) ------------------------------------------
LOVE2SHOP_BASE_URL=
LOVE2SHOP_API_KEY=
LOVE2SHOP_AUTH_HEADER=Authorization
LOVE2SHOP_AUTH_SCHEME=Bearer
LOVE2SHOP_PRODUCT_CODE=

# --- Tillo (gift-card issuance) ----------------------------------------------
TILLO_BASE_URL=https://sandbox.tillo.dev
TILLO_API_KEY=
TILLO_API_SECRET=
TILLO_BRAND=
TILLO_SECTOR=
TILLO_DELIVERY_METHOD=url
TILLO_FULFILMENT_BY=partner
TILLO_BRANDS_ALLOWLIST=

# --- Mail (SMTP, Office 365) -------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@bheuni.io
# SECRET — set in .env only, never commit a real password.
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@bheuni.io
AUTH_MAIL_FROM_ADDRESS=no-reply@bheuni.io
MAIL_FROM_NAME=BHE Uni Ambassador Portal

# --- MailerSend (transactional ESP, optional) --------------------------------
MAILERSEND_API_TOKEN=
MAILERSEND_FROM_ADDRESS=

# --- Misc --------------------------------------------------------------------
# Public URL of the ambassador portal (used in notification-email buttons).
PORTAL_URL=http://127.0.0.1:3000
# Comma-separated recipients of admin alert emails.
ADMIN_NOTIFY_EMAILS=sohail@bheuni.io
